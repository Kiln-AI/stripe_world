{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Seahaven state document under a built-in format",
  "description": "functional_spec.md §3.1, §3.2 and §4.2. additionalProperties is false throughout, so a field added by accident to the envelope, to a log record or to a call entry fails the test that reads this.",
  "type": "object",
  "required": [
    "format",
    "seahaven_version",
    "world",
    "composition",
    "fixture",
    "episode_id",
    "seed",
    "now",
    "startup",
    "call_count",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": ["seahaven.state/1", "seahaven.state+last_step/1", "seahaven.state+calls/1"]
    },
    "seahaven_version": {"type": "string"},
    "world": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "composition": {
      "type": ["object", "null"],
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "world",
          "world_version",
          "scope",
          "aliases",
          "schema_hash",
          "frozen_world_version"
        ],
        "additionalProperties": false,
        "properties": {
          "world": {"type": "string"},
          "world_version": {"type": "string"},
          "scope": {"type": ["string", "null"]},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "frozen_world_version": {"type": ["string", "null"]}
        }
      }
    },
    "fixture": {
      "type": ["object", "null"],
      "required": ["id", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["file_sha256"],
            "additionalProperties": false,
            "properties": {"file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        }
      }
    },
    "episode_id": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]},
    "now": {"type": ["string", "null"]},
    "startup": {"type": ["object", "null"]},
    "call_count": {"type": "integer", "minimum": 0},
    "state": {
      "type": "object",
      "required": ["db"],
      "additionalProperties": false,
      "properties": {
        "db": {
          "type": "object",
          "required": ["log"],
          "additionalProperties": false,
          "properties": {
            "log": {"type": "array", "items": {"$ref": "#/$defs/record"}}
          }
        },
        "calls": {"type": "array", "items": {"$ref": "#/$defs/call"}}
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["i", "world", "table", "op", "key", "before", "after"],
      "additionalProperties": false,
      "properties": {
        "i": {"type": ["integer", "null"], "minimum": 0},
        "world": {"type": "string"},
        "table": {"type": "string"},
        "op": {"enum": ["insert", "update", "delete"]},
        "key": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/value"}
        },
        "before": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/value"}},
        "after": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/value"}}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "insert"}}},
          "then": {"properties": {"before": {"type": "null"}, "after": {"type": "object"}}}
        },
        {
          "if": {"properties": {"op": {"const": "delete"}}},
          "then": {"properties": {"before": {"type": "object"}, "after": {"type": "null"}}}
        },
        {
          "if": {"properties": {"op": {"const": "update"}}},
          "then": {"properties": {"before": {"type": "object"}, "after": {"type": "object"}}}
        }
      ]
    },
    "call": {
      "type": "object",
      "required": ["tool", "arguments", "error"],
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string"},
        "arguments": {"type": "object"},
        "error": {"type": ["string", "null"]}
      }
    },
    "value": {"type": ["string", "number", "null"]}
  }
}
