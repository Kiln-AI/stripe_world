{
  "name": "openenv-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A general-purpose web UI for OpenEnv environments. Builds to a single self-contained index.html.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mock": "node mock/server.mjs",
    "check": "tsc --noEmit",
    "e2e": "node e2e/smoke.mjs",
    "licences": "node scripts/check-licences.mjs",
    "mock:plain": "node mock/server.mjs --port 8001 --plain"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "ws": "^8.18.0"
  }
}
